# Copy this file to .env and replace every CHANGE_ME value before running Docker Compose.
# JWT_SECRET must be at least 64 characters for HS512.

POSTGRES_DB=streambuted_identity
POSTGRES_USER=streambuted
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

RABBITMQ_DEFAULT_USER=streambuted
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASSWORD

JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_CHARACTERS_FOR_HS512_SIGNING_KEY
